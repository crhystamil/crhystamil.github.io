---
import { blogUrl, wikiUrl } from "../data/site";
import ThemeToggle from "./themeToggle.astro";
const path = Astro.url.pathname;
const links = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/services/" },
  { label: "Blog ↗", href: blogUrl },
  { label: "Cursos", href: "/courses/" },
  { label: "Wiki ↗", href: wikiUrl },
  { label: "Sobre mí", href: "/about/" },
];
---

<header class="header">
  <nav class="wrap navigation" aria-label="Navegación principal">
    <a class="brand" href="/" aria-label="El Cerrajero — Inicio">
      <img src="/elcerrajero.png" alt="" width="40" height="40" />
      <span class="brand-identity">
        El Cerrajero<span class="brand-dot">.</span>
        <small>CIBERSEGURIDAD &amp; FORMACIÓN</small>
      </span>
    </a>
    <div class="nav-actions">
      <div class="nav-links">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("https://") ? "_blank" : undefined}
            rel={
              link.href.startsWith("https://")
                ? "noopener noreferrer"
                : undefined
            }
            aria-current={
              (link.href === "/" ? path === "/" : path.startsWith(link.href))
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))}
      </div>
      <ThemeToggle />
    </div>
  </nav>
</header>
<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
    z-index: 100;
  }
  .navigation {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 82px;
    gap: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .brand img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    filter: grayscale(1) sepia(1) saturate(2) hue-rotate(85deg);
  }
  .brand-dot {
    color: var(--sec);
  }
  .brand-identity {
    line-height: 1.3;
  }
  .brand-identity small {
    display: block;
    margin-top: 4px;
    color: var(--white-icon);
    font-size: 7px;
    font-weight: 500;
    letter-spacing: 0.13em;
  }
  .nav-links {
    font-family: var(--mono);
    font-weight: 500;
    display: flex;
    gap: 30px;
    font-size: 12px;
    color: var(--white-icon);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav-links a[aria-current] {
    color: var(--white);
  }
  .nav-links a {
    white-space: nowrap;
  }
  .nav-links a[aria-current]::after {
    content: "";
    display: block;
    height: 3px;
    width: 12px;
    background: var(--sec);
    border-radius: 4px;
    margin: 5px auto -8px;
  }
  @media (max-width: 960px) {
    .nav-actions {
      width: 100%;
      justify-content: center;
    }
    .nav-actions :global(.theme-toggle) {
      position: absolute;
      right: 0;
      top: 10px;
      width: 32px;
      height: 32px;
    }
    .navigation {
      min-height: 90px;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
      padding: 10px 0;
    }
    .brand {
      font-size: 14px;
    }
    .brand img {
      height: 26px;
      width: 26px;
    }
    .nav-links {
      gap: clamp(8px, 2.5vw, 18px);
      font-size: 11px;
    }
  }
  @media (max-width: 420px) {
    .navigation {
      min-height: 116px;
    }
    .nav-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 12px 10px;
      text-align: center;
    }
  }
</style>
