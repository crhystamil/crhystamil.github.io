---
import {
  socials,
  blogUrl,
  wikiUrl,
  contactEmail,
  serviceContact,
} from "../data/site";
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <a class="footer-brand" href="/">
        El Cerrajero<span>.</span>
      </a>
      <p>Compartir conocimiento también es abrir puertas.</p>
      <div class="footer-resources">
        <a
          class="text-link"
          href={blogUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Blog en Medium ↗
        </a>
        <a
          class="text-link"
          href={wikiUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Wiki y recursos ↗
        </a>
      </div>
    </div>
    <div class="footer-contact">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 6 9 7 9-7" />
      </svg>
      <a href={serviceContact}>{contactEmail}</a>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} El Cerrajero · Ciberseguridad</p>
      <div class="socials">
        {socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            {social.name}
          </a>
        ))}
      </div>
      <p class="credits">
        <span class="online-dot" aria-hidden="true">
          ●
        </span>{" "}
        SYSTEM ONLINE / Astro
      </p>
    </div>
  </div>
</footer>
<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 42px 0 28px;
  }
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 32px;
  }
  .footer-brand {
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.05em;
  }
  .footer-resources {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer-brand span {
    color: var(--sec);
  }
  .footer-top p {
    font-size: 12px;
    color: var(--white-icon);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    font-size: 10px;
    color: var(--white-icon);
  }
  .footer-contact {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 26px;
    font-size: 13px;
    color: var(--sec);
  }
  .footer-contact a {
    overflow-wrap: anywhere;
  }
  .footer-contact svg {
    flex-shrink: 0;
  }
  .socials {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .credits {
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 9px;
  }
  .online-dot {
    color: var(--sec);
    margin-right: 4px;
  }
  @media (max-width: 900px) {
    .footer-top,
    .footer-bottom {
      align-items: start;
      flex-direction: column;
      gap: 18px;
    }
    .socials {
      gap: 16px 20px;
    }
  }
</style>
