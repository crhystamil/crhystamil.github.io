---
import { services, serviceContact } from "../data/site";
interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<div class:list={["services-grid", { detailed }]}>
  {services.map((service) => (
    <article class="card service-card" id={detailed ? service.id : undefined}>
      <div class="service-top">
        <svg
          viewBox="0 0 24 24"
          width="30"
          height="30"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={service.icon}
        />
        <span>{service.code}</span>
      </div>
      <h3>{service.title}</h3>
      <p>{service.description}</p>
      {detailed && (
        <ul>
          {service.scope.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
      <a
        class="service-link"
        href={detailed ? serviceContact : `/services/#${service.id}`}
        aria-label={`${detailed ? "Consultar sobre" : "Ver detalles de"} ${service.title}`}
      >
        {detailed ? "Consultar este servicio" : "Ver servicio"}{" "}
        <span aria-hidden="true">↗</span>
      </a>
    </article>
  ))}
</div>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    padding: 26px 22px;
    scroll-margin-top: 110px;
  }
  .service-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin-bottom: 20px;
    color: var(--sec);
  }
  .service-top span {
    font: 9px var(--mono);
    letter-spacing: 0.06em;
    color: var(--white-icon);
  }
  .service-card h3 {
    font-size: 21px;
    line-height: 1.35;
  }
  .service-card p {
    margin-bottom: 26px;
  }
  .service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--sec);
  }
  .detailed {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .detailed .service-card {
    padding: 32px;
  }
  .detailed .service-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
  .service-card ul {
    padding: 0;
    margin: 0 0 28px;
    list-style: none;
    color: var(--white-icon);
    font-size: 13px;
  }
  .service-card li {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
  }
  .service-card li::before {
    content: "✓";
    color: var(--sec);
  }
  @media (max-width: 1050px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .detailed .service-card {
      padding: 26px 22px;
    }
    .service-top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
