---
import TopicMarquee from "./topicMarquee.astro";
import { blogUrl } from "../data/site";
---

<section class="hero wrap" id="home">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> KEYMAKER / ACCESO AL CONOCIMIENTO
      </p>
      <h1>
        La llave a la
        <br />
        <span>ciberseguridad.</span>
      </h1>
      <p class="intro">
        La ciberseguridad es clave para proteger la información, fortalecer los
        sistemas y preservar la confianza en un mundo conectado. Identificar
        riesgos y desarrollar capacidades permite construir un entorno digital
        más seguro y resiliente.
      </p>
      <div class="hero-actions">
        <a
          class="button primary"
          href={blogUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Explorar el blog <span aria-hidden="true">↗</span>
        </a>
        <a class="button" href="/about/">
          Conoce mi historia <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hero-socials">
        <a
          href="https://github.com/crhystamil"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
        <a
          href="https://linkedin.com/in/crhystamil/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn ↗
        </a>
        <a
          href="https://youtube.com/@crhystamil"
          target="_blank"
          rel="noopener noreferrer"
        >
          YouTube ↗
        </a>
      </div>
    </div>
    <div class="visual">
      <img
        class="cybersecurity-image"
        src="/cybersecurity-hero.svg"
        width="560"
        height="520"
        alt="Escudo de ciberseguridad con un candado y conexiones a aplicaciones web, servidores, dispositivos móviles y formación."
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
  <TopicMarquee />
</section>
<style>
  .hero {
    padding-top: 174px;
    padding-bottom: 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    align-items: center;
    gap: 32px;
  }
  .hero h1 {
    font-size: clamp(42px, 5.4vw, 72px);
    font-weight: 600;
    line-height: 1.1;
    margin: 24px 0;
  }
  .hero h1 span {
    background: linear-gradient(100deg, var(--sec), var(--title-end));
    background-clip: text;
    color: transparent;
  }
  .intro {
    max-width: 580px;
    color: var(--white-icon);
    font-size: 15px;
    line-height: 1.95;
    font-weight: 500;
  }
  .hero-copy {
    position: relative;
    isolation: isolate;
  }
  .hero-copy::before {
    content: "";
    position: absolute;
    inset: -18px -10px;
    z-index: -1;
    background: var(--reading-scrim);
    border-radius: 14px;
    box-shadow: 0 0 24px 12px var(--reading-scrim);
    pointer-events: none;
  }
  .intro strong {
    color: var(--strong-text);
    font-weight: 500;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .hero-socials {
    display: flex;
    gap: 24px;
    font-size: 12px;
    color: var(--white-icon);
    margin-top: 28px;
  }
  .visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cybersecurity-image {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 16px 28px #00000030);
  }
  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--sec);
    border-radius: 50%;
    margin-right: 8px;
    box-shadow: 0 0 10px #71f6a260;
  }
  .hero-grid > div {
    min-width: 0;
  }
  @media (max-width: 760px) {
    .hero h1 {
      font-size: clamp(36px, 10.7vw, 52px);
    }
    .hero {
      padding-top: 140px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .visual {
      margin-top: 14px;
      max-width: 420px;
      margin-inline: auto;
    }
    .hero-socials {
      gap: 22px;
    }
    .eyebrow {
      font-size: 10px;
    }
  }
  @media (max-width: 420px) {
    .hero {
      padding-top: 164px;
    }
  }
</style>
